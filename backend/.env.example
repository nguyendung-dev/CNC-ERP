# Server Configuration
PORT=5002
NODE_ENV=production

# Frontend Client URL (Allow CORS from your Coolify Frontend domain)
CLIENT_URL=https://your-frontend-coolify-domain.com

# JWT Secret for Auth Token
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (Choose Option A or Option B)
# Option A: Standalone MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cnc_erp
DB_CONNECTION_LIMIT=10

# Option B: Railway MySQL Service (Automatically provided by Railway when linking MySQL service)
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=mysql://root:pass@host:port/railway

# Optional: Seed demo business data on startup (true/false)
SEED_DEMO=false
